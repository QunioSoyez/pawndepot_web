{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "pawndepot",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Non-secret settings (secrets like PRINTIFY_API_TOKEN go in .dev.vars locally / Cloudflare secrets in prod)
	"vars": {
		"PRINTIFY_SHOP_ID": "29715882"
	},
	"observability": {
		"enabled": true
	}
}