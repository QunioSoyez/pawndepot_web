{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-10",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "pawndepot",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	// Non-secret settings (secrets like PRINTIFY_API_TOKEN go in .dev.vars locally / Cloudflare secrets in prod)
	"vars": {
		"PRINTIFY_SHOP_ID": "29715882"
	},
	// Deploy guard: `wrangler deploy` fails if any of these Secrets is missing on the Worker.
	// Set them ONLY with `npx wrangler secret put <NAME>` (never the dashboard).
	// Note: with this list present, local dev loads ONLY these names from .dev.vars —
	// add any new secret here AND in .dev.vars.
	"secrets": {
		"required": [
			"PRINTIFY_API_TOKEN",
			"PRINTIFY_WEBHOOK_SECRET",
			"STRIPE_SECRET_KEY",
			"STRIPE_WEBHOOK_SECRET"
		]
	},
	"observability": {
		"enabled": true
	}
}