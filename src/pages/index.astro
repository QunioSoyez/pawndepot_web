---
/**
 * Home page — hero + "Featured" products.
 * Featured = FEATURED_PRODUCT_IDS in src/lib/printify.ts (see getFeatured()).
 * Rendered on each request so Printify changes show without redeploying
 * (Printify data is cached 5 min). If Printify fails or there are no products,
 * the Featured section is simply hidden — the hero still works.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { getProducts, getFeatured, type Product } from '../lib/printify';

export const prerender = false;

let featured: Product[] = [];

try {
  featured = getFeatured(await getProducts());
} catch (err) {
  const message = err instanceof Error ? err.message : String(err);
  console.error(`[home] Failed to load featured products: ${message}`, err);
}
---

<BaseLayout>
  <section class="hero">
    <img class="hero-logo" src="/logo.svg" alt="PawnDepot logo: a chess pawn in front of a red train depot" width="320" height="320" />
    <div class="hero-text">
      <h1>All aboard the <span class="accent">PawnDepot</span></h1>
      <p class="lead">Custom merch, printed on demand and shipped to your door.</p>
      <div class="hero-actions">
        <a href="/shop" class="btn">Shop now</a>
        <a href="/about" class="btn btn--outline">About us</a>
      </div>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="featured">
      <div class="featured-head">
        <h2>Featured</h2>
        <a href="/shop" class="see-all">See all products →</a>
      </div>
      <ProductGrid products={featured} headingLevel={3} />
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 2.5rem;
    padding: 1rem 0 3rem;
  }

  .hero-logo {
    width: clamp(180px, 28vw, 320px);
  }

  .accent {
    color: var(--depot-red);
  }

  .lead {
    font-size: 1.2rem;
    color: var(--steel);
    max-width: 32ch;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .featured-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .see-all {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  @media (max-width: 700px) {
    .hero {
      grid-template-columns: 1fr;
      text-align: center;
      justify-items: center;
    }
    .hero-actions {
      justify-content: center;
    }
  }
</style>
