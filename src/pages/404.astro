---
/**
 * 404 — "This train doesn't stop here."
 * Shown for any URL that doesn't match a page. Prerendered (static, no API
 * calls), so it costs nothing to serve. The departure board's "requested"
 * row is filled in by a tiny browser script with the path the shopper tried.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const departures = [
  { dest: 'Home', href: '/', track: '1', status: 'On time' },
  { dest: 'Shop', href: '/shop', track: '2', status: 'Boarding' },
  { dest: 'Cart', href: '/cart', track: '3', status: 'Waiting' },
];
---

<BaseLayout title="Page not found" description="That page isn't on our line — head back to the shop.">
  <section class="lost">
    <p class="kicker">Error 404 · Wrong platform</p>
    <h1>This train doesn't stop here.</h1>
    <p class="lead">
      The page you're looking for has left the station, or never ran on this line.
      Pick a departure below and we'll get you back on track.
    </p>

    <div class="board" role="table" aria-label="Departures">
      <div class="row head" role="row">
        <span role="columnheader">Destination</span>
        <span role="columnheader">Track</span>
        <span role="columnheader">Status</span>
      </div>

      <div class="row cancelled" role="row">
        <span role="cell" class="dest" data-requested-path>This page</span>
        <span role="cell">—</span>
        <span role="cell" class="status">Cancelled</span>
      </div>

      {departures.map((d) => (
        <a class="row" role="row" href={d.href}>
          <span role="cell" class="dest">{d.dest}</span>
          <span role="cell">{d.track}</span>
          <span role="cell" class="status">{d.status}</span>
        </a>
      ))}
    </div>

    <div class="actions">
      <a href="/" class="btn">Back to home</a>
      <a href="/shop" class="btn btn--outline">Browse the shop</a>
    </div>
  </section>
</BaseLayout>

<script>
  // Show the path the shopper tried in the "Cancelled" row (textContent = safe)
  const cell = document.querySelector<HTMLElement>('[data-requested-path]');
  const path = decodeURIComponent(location.pathname);
  if (cell && path && path !== '/404') {
    cell.textContent = path.length > 40 ? path.slice(0, 39) + '…' : path;
    cell.title = path;
  }
</script>

<style>
  .lost {
    max-width: 720px;
    margin: 1rem auto 3rem;
  }

  .kicker {
    margin: 0 0 0.25rem;
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--depot-red);
  }

  .lead {
    font-size: 1.15rem;
    color: var(--steel);
  }

  /* --- Departure board --- */
  .board {
    margin: 1.75rem 0 2rem;
    background: var(--ink);
    border: 4px solid var(--ink);
    border-top: 6px solid var(--depot-red);
    border-radius: var(--radius);
    overflow: hidden;
    font-family: var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr 5rem 8rem;
    gap: 1rem;
    align-items: center;
    padding: 0.7rem 1rem;
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid #2a2a2a;
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row span:not(.dest) {
    text-align: center;
  }

  .dest {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    text-transform: none;
    font-size: 1.15rem;
  }

  .head {
    color: var(--steel);
    font-size: 0.85rem;
  }

  .status {
    color: #f2c94c; /* classic amber board lettering */
  }

  .cancelled .dest {
    text-decoration: line-through;
    color: var(--steel);
  }

  .cancelled .status {
    color: var(--depot-red);
  }

  a.row:hover,
  a.row:focus-visible {
    background: var(--depot-red);
  }

  a.row:hover .status,
  a.row:focus-visible .status {
    color: var(--white);
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 480px) {
    .row {
      grid-template-columns: 1fr 3rem 6rem;
      gap: 0.5rem;
      padding: 0.6rem 0.75rem;
    }
    .dest {
      font-size: 1rem;
    }
  }
</style>
