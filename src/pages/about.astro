---
/**
 * /about — About PawnDepot.
 * Static (prerendered at build time): no API calls, costs nothing to serve.
 * Tone: playful railroad theme. "We" voice, no personal names.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="About PawnDepot — a small independent shop for tees, hoodies, mugs and more, shipped to your door."
>
  <article class="about">
    <header class="about-head">
      <p class="eyebrow">Now arriving</p>
      <h1>About the <span class="accent">Depot</span></h1>
      <p class="lead">
        We're a small, independent shop running one simple line: good designs on everyday merch —
        tees, hoodies, mugs, and whatever pulls into the station next.
      </p>
    </header>

    <section class="route" aria-labelledby="route-heading">
      <h2 id="route-heading">Your route</h2>
      <ol class="stops">
        <li class="stop">
          <span class="stop-no">Stop 1</span>
          <h3>Pick your ride</h3>
          <p>Browse the <a href="/shop">shop</a>, choose your size and color, and hop it into your cart.</p>
        </li>
        <li class="stop">
          <span class="stop-no">Stop 2</span>
          <h3>Punch your ticket</h3>
          <p>Checkout runs through Stripe, so your card details go straight to them — they never touch our servers.</p>
        </li>
        <li class="stop">
          <span class="stop-no">Stop 3</span>
          <h3>Arrive at your door</h3>
          <p>Your order is packed up and shipped to you. We currently ship within the United States.</p>
        </li>
      </ol>
    </section>

    <section class="desk" aria-labelledby="desk-heading">
      <h2 id="desk-heading">The station master's desk</h2>
      <p>
        Question about an order, a product, or anything else? Send a telegram (okay, an email) to <a href="mailto:help@pawndepot.shop">help@pawndepot.shop</a> and we'll get back to you.
      </p>
    </section>

    <div class="about-actions">
      <a href="/shop" class="btn">All aboard — shop now</a>
    </div>
  </article>
</BaseLayout>

<style>
  .about {
    max-width: 760px;
    margin: 0 auto;
    padding-bottom: 2rem;
  }

  .eyebrow {
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--depot-red);
    margin: 0 0 0.25rem;
  }

  .accent {
    color: var(--depot-red);
  }

  .lead {
    font-size: 1.2rem;
    color: var(--steel);
  }

  .route,
  .desk {
    margin-top: 2.5rem;
  }

  .stops {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Ticket-style cards: dashed "perforation" along the top */
  .stop {
    background: var(--white);
    border: 1px solid var(--rail);
    border-top: 3px dashed var(--depot-red);
    border-radius: var(--radius);
    padding: 1rem 1.1rem 1.2rem;
  }

  .stop-no {
    display: inline-block;
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    color: var(--white);
    background: var(--ink);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    margin-bottom: 0.6rem;
  }

  .stop h3 {
    font-size: 1.2rem;
    margin-bottom: 0.35rem;
  }

  .stop p {
    margin: 0;
  }

  .desk {
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius);
    padding: 1.25rem 1.5rem;
  }

  .desk h2 {
    color: var(--white);
  }

  .desk p {
    margin: 0;
  }

  .desk a {
    color: #f2c94c; /* amber, same as the 404 departure board */
  }

  .about-actions {
    margin-top: 2rem;
    text-align: center;
  }
</style>
