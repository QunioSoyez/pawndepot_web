---
/**
 * /shop — all products from Printify.
 * Rendered on each request (not at build time) so new products appear
 * without redeploying. Printify data is cached 5 min in src/lib/printify.ts.
 *
 * Filter by product type with ?type=<slug> (e.g. /shop?type=tees). Plain links,
 * so filtering works without JavaScript and filtered URLs can be shared.
 * Unknown types fall back to showing everything.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { getProducts, getCategories, type Product } from '../lib/printify';

export const prerender = false;

let products: Product[] = [];
let loadError = false;

try {
  products = await getProducts();
} catch (err) {
  // Log details for us (Cloudflare logs / terminal); show a friendly message to shoppers.
  // err.message first so the reason shows on one line in Cloudflare logs; full error (stack) after.
  const message = err instanceof Error ? err.message : String(err);
  console.error(`[shop] Failed to load products: ${message}`, err);
  loadError = true;
}

const categories = getCategories(products);
const requestedType = Astro.url.searchParams.get('type');
const activeCategory = categories.find((c) => c.slug === requestedType);
const shown = activeCategory ? products.filter((p) => p.category.slug === activeCategory.slug) : products;
const countFor = (slug: string) => products.filter((p) => p.category.slug === slug).length;
---

<BaseLayout
  title={activeCategory ? `${activeCategory.name} — Shop` : 'Shop'}
  description={activeCategory
    ? `Shop PawnDepot ${activeCategory.name.toLowerCase()} — printed on demand.`
    : 'Shop all PawnDepot merch — shirts and more, printed on demand.'}
>
  <h1>{activeCategory ? activeCategory.name : 'Shop'}</h1>

  {categories.length > 1 && (
    <nav class="filters" aria-label="Product types">
      <ul>
        <li>
          <a href="/shop" class:list={['filter', { active: !activeCategory }]} aria-current={!activeCategory ? 'page' : undefined}>
            All <span class="count">{products.length}</span>
          </a>
        </li>
        {categories.map((c) => {
          const isActive = activeCategory?.slug === c.slug;
          return (
            <li>
              <a href={`/shop?type=${c.slug}`} class:list={['filter', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>
                {c.name} <span class="count">{countFor(c.slug)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )}

  {loadError && (
    <p class="notice">Our product shelf is being restocked — please check back in a few minutes.</p>
  )}

  {!loadError && products.length === 0 && (
    <p class="notice">No products yet — new merch is on the way!</p>
  )}

  <ProductGrid products={shown} />
</BaseLayout>

<style>
  .filters ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 var(--gap);
    padding: 0;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.95rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .filter:hover {
    border-color: var(--depot-red);
    color: var(--depot-red);
  }

  .filter.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--steel);
  }

  .filter.active .count {
    color: var(--rail);
  }

  .notice {
    padding: 1rem 1.25rem;
    background: var(--white);
    border-left: 4px solid var(--depot-red);
    border-radius: var(--radius);
  }
</style>
