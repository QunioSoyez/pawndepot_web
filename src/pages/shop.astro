---
/**
 * /shop — all products from Printify.
 * Rendered on each request (not at build time) so new products appear
 * without redeploying. Printify data is cached 5 min in src/lib/printify.ts.
 *
 * Filter by product type with ?type=<slug> (e.g. /shop?type=tees). Plain links,
 * so filtering works without JavaScript and filtered URLs can be shared.
 * Unknown types fall back to showing everything.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getProducts, getCategories, formatPrice, primaryImage, type Product } from '../lib/printify';

export const prerender = false;

let products: Product[] = [];
let loadError = false;

try {
  products = await getProducts();
} catch (err) {
  // Log details for us (Cloudflare logs / terminal); show a friendly message to shoppers
  console.error('[shop] Failed to load products:', err);
  loadError = true;
}

const categories = getCategories(products);
const requestedType = Astro.url.searchParams.get('type');
const activeCategory = categories.find((c) => c.slug === requestedType);
const shown = activeCategory ? products.filter((p) => p.category.slug === activeCategory.slug) : products;
const countFor = (slug: string) => products.filter((p) => p.category.slug === slug).length;

/** "$25.00" or "From $25.00" when sizes have different prices */
function priceLabel(p: Product): string {
  return p.priceMin === p.priceMax ? formatPrice(p.priceMin) : `From ${formatPrice(p.priceMin)}`;
}

/** Color swatches for the card (first color-type option, max 8 shown) */
function swatches(p: Product) {
  const colorOpt = p.options.find((o) => o.type === 'color');
  return colorOpt ? colorOpt.values.filter((v) => v.colors?.length) : [];
}
---

<BaseLayout
  title={activeCategory ? `${activeCategory.name} — Shop` : 'Shop'}
  description={activeCategory
    ? `Shop PawnDepot ${activeCategory.name.toLowerCase()} — printed on demand.`
    : 'Shop all PawnDepot merch — shirts and more, printed on demand.'}
>
  <h1>{activeCategory ? activeCategory.name : 'Shop'}</h1>

  {categories.length > 1 && (
    <nav class="filters" aria-label="Product types">
      <ul>
        <li>
          <a href="/shop" class:list={['filter', { active: !activeCategory }]} aria-current={!activeCategory ? 'page' : undefined}>
            All <span class="count">{products.length}</span>
          </a>
        </li>
        {categories.map((c) => {
          const isActive = activeCategory?.slug === c.slug;
          return (
            <li>
              <a href={`/shop?type=${c.slug}`} class:list={['filter', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>
                {c.name} <span class="count">{countFor(c.slug)}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )}

  {loadError && (
    <p class="notice">Our product shelf is being restocked — please check back in a few minutes.</p>
  )}

  {!loadError && products.length === 0 && (
    <p class="notice">No products yet — new merch is on the way!</p>
  )}

  {shown.length > 0 && (
    <ul class="product-grid">
      {shown.map((p) => {
        const img = primaryImage(p);
        const colors = swatches(p);
        return (
          <li class="product-card">
            <a href={`/product/${p.id}`} class="card-link">
              <div class="card-img">
                {img ? (
                  <img src={img.src} alt={p.title} loading="lazy" width="400" height="400" />
                ) : (
                  <div class="no-img" aria-hidden="true"></div>
                )}
              </div>
              <div class="card-body">
                <h2 class="card-title">{p.title}</h2>
                <p class="card-price">{priceLabel(p)}</p>
                {colors.length > 0 && (
                  <div class="swatches" aria-label={`${colors.length} colors available`}>
                    {colors.slice(0, 8).map((c) => (
                      <span class="swatch" style={`background:${c.colors![0]}`} title={c.title}></span>
                    ))}
                    {colors.length > 8 && <span class="more">+{colors.length - 8}</span>}
                  </div>
                )}
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>

<style>
  .filters ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0 0 var(--gap);
    padding: 0;
  }

  .filter {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.95rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .filter:hover {
    border-color: var(--depot-red);
    color: var(--depot-red);
  }

  .filter.active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--white);
  }

  .count {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--steel);
  }

  .filter.active .count {
    color: var(--rail);
  }

  .notice {
    padding: 1rem 1.25rem;
    background: var(--white);
    border-left: 4px solid var(--depot-red);
    border-radius: var(--radius);
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-card {
    background: var(--white);
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-img {
    aspect-ratio: 1;
    background: var(--paper);
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-img {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, var(--paper), var(--paper) 10px, var(--rail) 10px, var(--rail) 20px);
  }

  .card-body {
    padding: 0.9rem 1rem 1.1rem;
  }

  .card-title {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .card-price {
    font-weight: 700;
    color: var(--depot-red);
    margin: 0 0 0.6rem;
  }

  .swatches {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.25);
  }

  .more {
    font-size: 0.8rem;
    color: var(--steel);
  }
</style>
