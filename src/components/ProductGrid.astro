---
/**
 * Product card grid — used by /shop and the home page "Featured" section.
 * Card look: mockup photo, title, price ("From $X" when sizes differ), color swatches.
 *
 * Props:
 *   products      — products to show (renders nothing if empty)
 *   headingLevel  — 2 (default, page has only an h1 above) or 3 (inside a section with its own h2)
 */
import { formatPrice, primaryImage, type Product } from '../lib/printify';

interface Props {
  products: Product[];
  headingLevel?: 2 | 3;
}

const { products, headingLevel = 2 } = Astro.props;
const Heading = headingLevel === 3 ? 'h3' : 'h2';

/** "$25.00" or "From $25.00" when sizes have different prices */
function priceLabel(p: Product): string {
  return p.priceMin === p.priceMax ? formatPrice(p.priceMin) : `From ${formatPrice(p.priceMin)}`;
}

/** Color swatches for the card (first color-type option, max 8 shown) */
function swatches(p: Product) {
  const colorOpt = p.options.find((o) => o.type === 'color');
  return colorOpt ? colorOpt.values.filter((v) => v.colors?.length) : [];
}
---

{products.length > 0 && (
  <ul class="product-grid">
    {products.map((p) => {
      const img = primaryImage(p);
      const colors = swatches(p);
      return (
        <li class="product-card">
          <a href={`/product/${p.id}`} class="card-link">
            <div class="card-img">
              {img ? (
                <img src={img.src} alt={p.title} loading="lazy" width="400" height="400" />
              ) : (
                <div class="no-img" aria-hidden="true"></div>
              )}
            </div>
            <div class="card-body">
              <Heading class="card-title">{p.title}</Heading>
              <p class="card-price">{priceLabel(p)}</p>
              {colors.length > 0 && (
                <div class="swatches" aria-label={`${colors.length} colors available`}>
                  {colors.slice(0, 8).map((c) => (
                    <span class="swatch" style={`background:${c.colors![0]}`} title={c.title}></span>
                  ))}
                  {colors.length > 8 && <span class="more">+{colors.length - 8}</span>}
                </div>
              )}
            </div>
          </a>
        </li>
      );
    })}
  </ul>
)}

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--gap);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-card {
    background: var(--white);
    border: 1px solid var(--rail);
    border-radius: var(--radius);
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .product-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
  }

  .card-link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .card-img {
    aspect-ratio: 1;
    background: var(--paper);
  }

  .card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .no-img {
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(45deg, var(--paper), var(--paper) 10px, var(--rail) 10px, var(--rail) 20px);
  }

  .card-body {
    padding: 0.9rem 1rem 1.1rem;
  }

  .card-title {
    font-size: 1.2rem;
    margin-bottom: 0.25rem;
  }

  .card-price {
    font-weight: 700;
    color: var(--depot-red);
    margin: 0 0 0.6rem;
  }

  .swatches {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .swatch {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.25);
  }

  .more {
    font-size: 0.8rem;
    color: var(--steel);
  }
</style>
